# Gnani AI API key ID from the participant API platform
GNANI_API_KEY_ID=replace-with-your-gnani-api-key-id

# Document reasoning. Groq handles image and text files; Gemini is required for PDFs and serves as a fallback.
GROQ_API_KEY=replace-with-your-groq-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional
PORT=3000
